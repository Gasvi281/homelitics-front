# Base del API. Solo la lee el servidor.
HOMELITICS_API_URL=https://homelitics-api.onrender.com

# El mismo proyecto de Supabase que valida los tokens del API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key, es público por diseño>

# Asistente de insights del admin (docs/INSIGHTS.md). Pública: el navegador
# le habla directo, sin proxy (tarda hasta un minuto). Sin barra al final.
NEXT_PUBLIC_INSIGHTS_URL=

# Cuenta de servicio limitada (un AGENT, no TEAM_ADMIN) para las pantallas de
# cliente, que no tienen sesión. Solo la usan apiPublico y /api/publico/*
# (lista blanca). Los agentes entran con su propia cuenta en /entrar.
SERVICE_AGENT_EMAIL=
SERVICE_AGENT_PASSWORD=

# true: lib/homelitics.ts responde desde lib/mock/ sin tocar la red.
USE_MOCKS=true
# Espejo público de USE_MOCKS: Next solo mete al bundle del navegador las
# variables NEXT_PUBLIC_*, y lib/homelitics-navegador.ts (la mitad que usan
# los Client Components) necesita saber si debe usar mocks también del lado
# del cliente. Mantenla igual a USE_MOCKS.
NEXT_PUBLIC_USE_MOCKS=true
# Rol del agente del mock: AGENT o TEAM_ADMIN (por defecto). Con AGENT
# desaparecen reasignar, /embudo y /riesgo. Solo cuenta con USE_MOCKS=true;
# con mocks no hace falta ninguna credencial y /entrar salta al tablero.
MOCK_AGENT_ROLE=TEAM_ADMIN

# Interruptores por endpoint (2.25): endpoints PROPUESTOS que aún no existen
# (docs/API_CONTRACT.md §8). Con USE_MOCKS=false siguen en mock mientras no
# digan false; sin la variable cuentan como true. Solo servidor.
USE_MOCK_TAREAS_AGENCIA=true
USE_MOCK_RIESGO_POR_AGENTE=true
